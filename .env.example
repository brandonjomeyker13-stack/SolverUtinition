# Copia este archivo como .env y rellena los valores.
# El .env NUNCA se sube a git: contiene secretos.

# =============================================================================
# Obligatorias: sin estas dos la app no arranca
# =============================================================================

# Cadena de Postgres de Supabase.
# En el dashboard: Project Settings -> Database -> Connection string (URI).
# Usa "Session mode" (puerto 5432) para Alembic y para desarrollo.
# En Render puedes usar "Transaction mode" (puerto 6543): el engine lo detecta
# y apaga el pool de SQLAlchemy, que no convive bien con PgBouncer.
# Si te dan postgres://, no pasa nada: la app lo convierte a postgresql://.
# Ejemplo session:
# DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Firma de los JWT de sesión y del state de OAuth de Chess.com.
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# =============================================================================
# Entorno
# =============================================================================

# development | production
# En production se ocultan /docs y /redoc, y la cookie de sesión sale Secure.
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Frontend y CORS
# =============================================================================

# Origen exacto del front, con http(s):// y SIN barra final.
# Varios separados por coma. Local + Vercel de producción y preview.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://solucionador-de-uso-front.vercel.app,https://solucionador-utinicion-front-2ftujmjqc-orderscode.vercel.app

# Si lo dejas vacío, se usa https://.*\.vercel\.app para los deploys de Vercel.
CORS_ORIGIN_REGEX=

# Se usa para redirigir al front cuando Chess.com devuelve el usuario
# (callback OAuth). Sin path, solo el origen.
FRONTEND_URL=https://solucionador-de-uso-front.vercel.app

# =============================================================================
# Sesiones
# =============================================================================

ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=60

# =============================================================================
# Elo interno
# =============================================================================

# Todos empiezan aquí, un rating por ritmo (bullet / blitz / rapid).
ELO_INICIAL=1000

# K de Elo. 20 mueve el ranking sin inflarlo: entre iguales una victoria
# suma 10. Si se siente lento, súbelo a 24 o 32.
ELO_K=20

# =============================================================================
# Google Sign-In
# =============================================================================

# Client ID de Google Cloud Console (tipo "Aplicación web").
# 1. https://console.cloud.google.com/apis/credentials
# 2. Crear OAuth client ID -> Web application
# 3. Authorized JavaScript origins:
#    http://localhost:5173
#    http://localhost:3000
#    https://TU-FRONT.vercel.app
# 4. Authorized redirect URIs no hacen falta si el front usa Google Identity
#    Services (el botón manda el id_token a POST /api/v1/auth/google).
# El front usa este mismo Client ID. El backend solo lo usa para verificar
# que el token es de ESA app, no de otra.
# Sin esto, POST /auth/google responde 401.
GOOGLE_CLIENT_ID=

# =============================================================================
# Chess.com
# =============================================================================

# App OAuth de Chess.com (la de práctica sirve SI le agregas el redirect
# de esta API). Chess.com tiene que haber aprobado la app.
# Authorization: https://oauth.chess.com/authorize
# Token:         https://oauth.chess.com/token
CHESSCOM_CLIENT_ID=
CHESSCOM_CLIENT_SECRET=

# Debe coincidir EXACTO con el URI registrado en Chess.com.
# Local:  http://localhost:8000/api/v1/chesscom/callback
# Render: https://TU-SERVICIO.onrender.com/api/v1/chesscom/callback
CHESSCOM_REDIRECT_URI=http://localhost:8000/api/v1/chesscom/callback

# Chess.com exige un User-Agent que identifique la app y un contacto.
# Sin esto (o con uno genérico tipo python-httpx) te bloquean.
# Ejemplo: SolverUnition (erwin@tu-correo.com)
CHESSCOM_USER_AGENT=

# =============================================================================
# Lichess
# =============================================================================

# No hay aprobación de por medio. Con la sesión iniciada en Lichess:
#   https://lichess.org/account/oauth/app/create
# Nombre: SolverUnition
# Redirect URI: EXACTO el de abajo. Lichess guarda uno por app.
#   Local:  http://localhost:8000/api/v1/lichess/callback
#   Render: https://TU-SERVICIO.onrender.com/api/v1/lichess/callback
# Si vas a usar local y Render a la vez, crea dos apps y cambia este client id.
# No pidas scopes: solo identificamos la cuenta. Las partidas se leen en público.
LICHESS_CLIENT_ID=

LICHESS_REDIRECT_URI=http://localhost:8000/api/v1/lichess/callback

# Lichess pide un User-Agent con contacto. Si lo dejas vacío se reutiliza
# CHESSCOM_USER_AGENT.
# Ejemplo: SolverUnition (erwin@tu-correo.com)
LICHESS_USER_AGENT=

# =============================================================================
# Job de sincronización (Render Cron)
# =============================================================================

# Header: X-Cron-Secret
# El cron de Render pega a POST /api/v1/partidas/sincronizar cada N minutos.
# Si lo dejas vacío, ese endpoint responde 404: no hay puerta abierta.
CRON_SECRET=
